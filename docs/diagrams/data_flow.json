{
  "name": "data_flow",
  "type": "route",
  "title": "BaseFWX data flow",
  "summary": "The selected CLI command transforms file, stream, or text input into the requested output.",
  "targets": {
    "web": false
  },
  "nodes": [
    {
      "id": "step0",
      "kind": "process",
      "title": "INPUT",
      "sub": "file, stream, or text"
    },
    {
      "id": "step1",
      "kind": "process",
      "title": "BASEFWX CLI",
      "sub": "selected command + options"
    },
    {
      "id": "step2",
      "kind": "process",
      "title": "BASEFWX OUTPUT",
      "sub": "container or stream"
    }
  ],
  "edges": [
    {
      "from": "step0",
      "to": "step1"
    },
    {
      "from": "step1",
      "to": "step2"
    }
  ]
}
